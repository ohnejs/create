{
  "compilerOptions": {
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["bin.js", "tests/**/*.ts"]
}
